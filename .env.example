# Clave privada de la API de AEMET
AEMET_API_KEY=pon_aqui_tu_clave_de_aemet

# Credenciales del proyecto de Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=pon_aqui_tu_url_de_supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=pon_aqui_tu_anon_key_de_supabase

# Clave publicable (Project Settings > API Keys, formato sb_publishable_...). Opcional: si falta se usa la anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=pon_aqui_tu_publishable_key

# Solo servidor (NUNCA con prefijo NEXT_PUBLIC_): necesarias para DELETE /api/data
SUPABASE_SERVICE_ROLE_KEY=pon_aqui_tu_service_role_key
ADMIN_DELETE_TOKEN=pon_aqui_un_token_largo_y_aleatorio
